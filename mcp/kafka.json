{
  "name": "kafka",
  "title": "Kafka",
  "brand": "apachekafka",
  "description": "Kafka 클러스터·토픽·컨슈머 그룹 조회",
  "version": 2,
  "mcp": {
    "repo": "hive-ao/hive-releases",
    "asset": "kafka-mcp-{os}-{arch}",
    "tag_prefix": "mcp/",
    "binary": "kafka-mcp"
  },
  "cli": {
    "repo": "hive-ao/hive-releases",
    "asset": "kafka-cli-{os}-{arch}",
    "tag_prefix": "kafka-cli/",
    "binary": "kafka-cli"
  },
  "cli_bin_env": "KAFKA_MCP_CLI_BIN",
  "configure": {
    "method": "standard"
  },
  "guide": "Kafka 브로커(bootstrap) 주소만 있으면 된다. 인증 없는 클러스터가 전제다."
}
