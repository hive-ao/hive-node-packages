{
  "name": "sshman",
  "title": "SSH Manager",
  "brand": "",
  "description": "SSH 호스트(~/.ssh/config)·터널 조회와 관리",
  "version": 2,
  "mcp": {
    "repo": "hive-ao/hive-releases",
    "asset": "sshman-mcp-{os}-{arch}",
    "tag_prefix": "mcp/",
    "binary": "sshman-mcp"
  },
  "cli": {
    "repo": "hive-ao/hive-releases",
    "asset": "sshman-{os}-{arch}",
    "tag_prefix": "sshman/",
    "binary": "sshman"
  },
  "cli_bin_env": "SSHMAN_MCP_CLI_BIN",
  "configure": {
    "method": "standard"
  },
  "guide": "준비물이 없다. 호스트는 ~/.ssh/config에 있으면 된다."
}
