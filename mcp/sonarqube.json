{
  "name": "sonarqube",
  "title": "SonarQube",
  "brand": "sonarqube",
  "description": "SonarQube 프로젝트·품질 게이트 조회",
  "version": 2,
  "mcp": {
    "repo": "hive-ao/hive-releases",
    "asset": "sonarqube-mcp-{os}-{arch}",
    "tag_prefix": "mcp/",
    "binary": "sonarqube-mcp"
  },
  "cli": {
    "repo": "hive-ao/hive-releases",
    "asset": "sonar-cli-{os}-{arch}",
    "tag_prefix": "sonar-cli/",
    "binary": "sonar-cli"
  },
  "cli_bin_env": "SONARQUBE_MCP_CLI_BIN",
  "configure": {
    "method": "standard"
  },
  "guide": "SonarQube 주소와 My Account › Security에서 만든 사용자 토큰(Cloud면 조직 키도)."
}
