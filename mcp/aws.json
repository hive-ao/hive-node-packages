{
  "name": "aws",
  "title": "AWS",
  "brand": "amazonwebservices",
  "description": "AWS 리소스 읽기 전용 조회",
  "version": 1,
  "mcp": {
    "repo": "hive-ao/hive-releases",
    "asset": "aws-mcp-{os}-{arch}",
    "tag_prefix": "mcp/",
    "binary": "aws-mcp"
  },
  "cli": {
    "repo": "hive-ao/hive-releases",
    "asset": "aws-ro-cli-{os}-{arch}",
    "tag_prefix": "aws-cli/",
    "binary": "aws-ro-cli"
  },
  "cli_bin_env": "AWS_MCP_CLI_BIN",
  "configure": {
    "method": "init",
    "profiles": true,
    "config": "~/.aws-ro-cli/config.yaml",
    "fields": [
      {
        "key": "access_key_id",
        "label": "액세스 키 ID",
        "kind": "text",
        "required": true,
        "help": "읽기 전용 IAM 사용자의 액세스 키 ID",
        "env": "AWS_RO_CLI_ACCESS_KEY_ID"
      },
      {
        "key": "secret_access_key",
        "label": "시크릿 액세스 키",
        "kind": "secret",
        "required": true,
        "help": "위 액세스 키 ID의 시크릿 키",
        "env": "AWS_RO_CLI_SECRET_ACCESS_KEY"
      },
      {
        "key": "region",
        "label": "리전",
        "kind": "text",
        "required": true,
        "default": "ap-northeast-2",
        "help": "예: ap-northeast-2"
      }
    ],
    "init": {
      "args": [
        "config",
        "init",
        "--region",
        "{region}"
      ],
      "env": {
        "AWS_RO_CLI_ACCESS_KEY_ID": "access_key_id",
        "AWS_RO_CLI_SECRET_ACCESS_KEY": "secret_access_key"
      }
    },
    "note": "~/.aws를 보지 않고 여기 넣은 키만 쓴다. 키는 플래그가 아니라 환경 변수로 넘겨 프로세스 목록에 남기지 않는다."
  },
  "verify": {
    "args": [
      "whoami",
      "--agent",
      "--json"
    ],
    "auth_exit_codes": [
      2
    ]
  },
  "guide": "읽기 전용 IAM 사용자의 키와 리전을 넣는다. 프로필은 연결 목록에서 더하고, `default`는 늘 있다. MCP 호출에서 프로필을 비우면 default를 쓴다."
}
