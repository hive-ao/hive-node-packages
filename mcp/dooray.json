{
  "name": "dooray",
  "title": "Dooray",
  "brand": "",
  "description": "Dooray 프로젝트·업무·위키·메신저",
  "version": 1,
  "mcp": {
    "repo": "hive-ao/hive-releases",
    "asset": "dooray-mcp-{os}-{arch}",
    "tag_prefix": "mcp/",
    "binary": "dooray-mcp"
  },
  "cli": {
    "repo": "hive-ao/hive-releases",
    "asset": "dooray-cli-{os}-{arch}",
    "tag_prefix": "dooray-cli/",
    "binary": "dooray-cli"
  },
  "cli_bin_env": "DOORAY_MCP_CLI_BIN",
  "configure": {
    "method": "yaml",
    "fields": [
      {
        "key": "host",
        "label": "API 주소",
        "kind": "text",
        "required": true,
        "help": "보통 https://api.dooray.com"
      },
      {
        "key": "token",
        "label": "API 토큰",
        "kind": "secret",
        "required": true,
        "help": "형식 테넌트ID:토큰"
      },
      {
        "key": "admin_token",
        "label": "Admin 토큰(선택)",
        "kind": "secret",
        "help": "회원 전체·조직 조회(member list/get·organization list)에만 쓴다 — 요금제 제한"
      }
    ],
    "yaml": {
      "path": "~/.config/dooray-cli/config.yaml",
      "template": "dooray:\n  host: {host}\n  token: {token}\n  adminToken: {admin_token}\n"
    }
  },
  "verify": {
    "args": [
      "member",
      "me",
      "--agent",
      "--json"
    ],
    "auth_exit_codes": [
      2,
      3
    ]
  },
  "guide": "Dooray API 토큰(테넌트ID:토큰)과 API 호스트(보통 https://api.dooray.com). 회원 전체 조회까지 쓰려면 Admin 토큰을 따로 넣는다."
}
