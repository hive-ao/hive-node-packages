{
  "name": "youtube",
  "title": "YouTube",
  "brand": "youtube",
  "description": "YouTube 채널·영상·분석 조회와 업로드",
  "version": 1,
  "mcp": {
    "repo": "hive-ao/hive-releases",
    "asset": "youtube-mcp-{os}-{arch}",
    "tag_prefix": "mcp/",
    "binary": "youtube-mcp"
  },
  "cli": {
    "repo": "hive-ao/hive-releases",
    "asset": "youtube-cli-{os}-{arch}",
    "tag_prefix": "youtube-cli/",
    "binary": "youtube-cli"
  },
  "cli_bin_env": "YOUTUBE_MCP_CLI_BIN",
  "configure": {
    "method": "init",
    "profiles": true,
    "config": "~/.youtube-cli/config.yaml",
    "fields": [
      {
        "key": "client_secret_file",
        "label": "OAuth 클라이언트(JSON)",
        "kind": "file",
        "required": true,
        "help": "GCP의 데스크톱 앱 OAuth 클라이언트 JSON — 파일을 올리거나 내용을 붙여 넣는다",
        "store": "~/.youtube-cli/client_secret.json"
      }
    ],
    "init": {
      "args": [
        "config",
        "init",
        "--client-secret-file",
        "{client_secret_file}"
      ]
    }
  },
  "verify": {
    "args": [
      "channel",
      "view",
      "--agent",
      "--json"
    ],
    "auth_exit_codes": [
      2
    ]
  },
  "login": {
    "args": [
      "auth",
      "login"
    ],
    "note": "하이브가 도는 PC에서 브라우저가 열린다 — 다른 PC에서 웹을 보고 있으면 그 PC에서 로그인할 수 없다."
  },
  "guide": "GCP에서 YouTube Data API v3·Analytics API를 켜고 OAuth 동의 화면(테스트 사용자에 채널 계정)과 데스크톱 앱 OAuth 클라이언트 JSON을 만든다. 설정 뒤 이 PC의 브라우저로 채널 소유 계정에 로그인한다."
}
